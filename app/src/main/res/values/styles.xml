<resources>
    <!-- Square D-pad button sized for thumb use on the small SP-01 screen. -->
    <style name="RemoteButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="cornerRadius">18dp</item>
        <item name="rippleColor">@color/primary</item>
    </style>
</resources>
